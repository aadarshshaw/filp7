    "prepare": "husky"
  },
  "dependencies": {
    "express": "^4.21.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2"
  }
}
