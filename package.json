{
  "name": "flip7",
  "version": "1.0.0",
  "description": "Flip 7 — Online Multiplayer Card Game",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit --forceExit",
    "test:e2e": "playwright test",
